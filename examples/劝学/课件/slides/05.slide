    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 24, color: '#4B463F' }}>任务链</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'row', gap: 26 }}>
    <Box style={{ flex: 1, background: 'rgba(75,70,63,0.06)', padding: '42px 30px', flexDirection: 'column', justifyContent: 'space-between' }}>
      <Text style={{ fontFamily: 'KaiTi', fontSize: 96, fontWeight: 'bold', color: '#9C2E22', opacity: 0.4, lineHeight: 1 }}>01</Text>

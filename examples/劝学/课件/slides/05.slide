        <Text style={{ fontFamily: 'KaiTi', fontSize: 44, fontWeight: 'bold', color: '#1C1A17' }}>找喻体</Text>
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 26, color: '#4B463F', marginTop: 14, lineHeight: 1.5 }}>它们的共同点</Text>
      </Box>
    </Box>

    <Box style={{ flex: 1, background: 'rgba(75,70,63,0.06)', padding: '42px 30px', flexDirection: 'column', justifyContent: 'space-between' }}>
      <Text style={{ fontFamily: 'KaiTi', fontSize: 96, fontWeight: 'bold', color: '#9C2E22', opacity: 0.4, lineHeight: 1 }}>02</Text>
      <Box>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 44, fontWeight: 'bold', color: '#1C1A17' }}>找借力</Text>
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 26, color: '#4B463F', marginTop: 14, lineHeight: 1.5 }}>借什么，得什么</Text>
      </Box>
    </Box>

    <Box style={{ flex: 1, background: 'rgba(75,70,63,0.06)', padding: '42px 30px', flexDirection: 'column', justifyContent: 'space-between' }}>

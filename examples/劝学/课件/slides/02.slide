<Slide style={{ width: 1280, height: 720, padding: '20px 64px', background: '#F4F1E9', flexDirection: 'column' }}>
  <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 6, height: 40, background: '#9C2E22' }} />
      <Text style={{ fontFamily: 'KaiTi', fontSize: 40, fontWeight: 'bold', color: '#1C1A17' }}>他是在说靛青吗？</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 24, color: '#4B463F' }}>导入</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'row', gap: 48, alignItems: 'center' }}>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 32 }}>
      <Text style={{ fontFamily: 'KaiTi', fontSize: 52, fontWeight: 'bold', color: '#1C1A17', lineHeight: 1.5 }}>
        青，取之于蓝，<br />而青于蓝。
      </Text>
      <Box style={{ width: 72, height: 3, background: 'rgba(28,26,23,0.25)' }} />
      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 28, color: '#4B463F', lineHeight: 1.7 }}>
        这是《劝学》的第一句，<br />说的却是靛青。
      </Text>
    </Box>
    <Image src="assets/img_1_indigo.jpg" style={{ width: 512, height: 432, objectFit: 'cover' }} />
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 24, color: '#4B463F' }}>劝学 · 荀子</Text>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 24, color: '#4B463F' }}>02 / 17</Text>
  </Box>
</Slide>

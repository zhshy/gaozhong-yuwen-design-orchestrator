    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 24, color: '#4B463F' }}>任务一</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'row', gap: 48, alignItems: 'center' }}>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, height: 62 }}>
        <Box style={{ width: 12, height: 12, background: '#9C2E22' }} />
        <Text style={{ fontFamily: 'KaiTi', fontSize: 38, color: '#4B463F' }}>青于蓝</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, height: 62 }}>
        <Box style={{ width: 12, height: 12, background: '#9C2E22' }} />
        <Text style={{ fontFamily: 'KaiTi', fontSize: 38, color: '#4B463F' }}>寒于水</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, height: 62 }}>
        <Box style={{ width: 12, height: 12, background: '#9C2E22' }} />
        <Text style={{ fontFamily: 'KaiTi', fontSize: 38, color: '#4B463F' }}>輮以为轮</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, height: 62 }}>
        <Box style={{ width: 12, height: 12, background: '#9C2E22' }} />
        <Text style={{ fontFamily: 'KaiTi', fontSize: 38, color: '#4B463F' }}>受绳则直</Text>

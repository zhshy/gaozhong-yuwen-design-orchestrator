<Slide style={{ width: 1280, height: 720, padding: '20px 64px', background: '#F4F1E9', flexDirection: 'column' }}>
  <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 6, height: 40, background: '#9C2E22' }} />
      <Text style={{ fontFamily: 'KaiTi', fontSize: 40, fontWeight: 'bold', color: '#1C1A17' }}>他为什么说「学不可以已」？</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 24, color: '#4B463F' }}>作者</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'row', gap: 48, alignItems: 'center' }}>
    <Box style={{ width: 452, height: 452, position: 'relative' }}>
      <Image src="assets/img_2_author.jpg" style={{ width: 452, height: 452, objectFit: 'cover' }} />
      <Text style={{ position: 'absolute', left: 0, bottom: 0, fontFamily: 'Microsoft YaHei', fontSize: 24, color: '#F4F1E9', background: 'rgba(28,26,23,0.62)', padding: '5px 14px' }}>意象化形象 · 示意图</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', gap: 42 }}>
      <Box style={{ flexDirection: 'row', gap: 22, alignItems: 'flex-start' }}>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 56, fontWeight: 'bold', color: '#9C2E22', lineHeight: 1 }}>①</Text>
        <Box>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 40, fontWeight: 'bold', color: '#1C1A17' }}>人性本恶</Text>
          <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 28, color: '#4B463F', marginTop: 12, lineHeight: 1.6 }}>所以必须靠「学」改造。</Text>
        </Box>
      </Box>

      <Box style={{ width: '100%', height: 1, background: 'rgba(28,26,23,0.14)' }} />

      <Box style={{ flexDirection: 'row', gap: 22, alignItems: 'flex-start' }}>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 56, fontWeight: 'bold', color: '#4B463F', lineHeight: 1 }}>②</Text>
        <Box>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 40, fontWeight: 'bold', color: '#1C1A17' }}>稷下讲学</Text>
          <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 28, color: '#4B463F', marginTop: 12, lineHeight: 1.6 }}>《劝学》是《荀子》开篇。</Text>
        </Box>
      </Box>
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 24, color: '#4B463F' }}>劝学 · 荀子</Text>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 24, color: '#4B463F' }}>03 / 17</Text>
  </Box>
</Slide>

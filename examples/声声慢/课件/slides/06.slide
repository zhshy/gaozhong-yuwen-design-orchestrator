    <Box style={{ width: 420, paddingRight: 40, flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 28, color: '#1F3A34', lineHeight: 1.9 }}>这十四个字，是从</Text>
      <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#B4552D', lineHeight: 1.9 }}>外面</Text>
      <Text style={{ fontSize: 28, color: '#1F3A34', lineHeight: 1.9 }}>走到了</Text>
      <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#B4552D', lineHeight: 1.9 }}>心里</Text>
      <Text style={{ fontSize: 28, color: '#1F3A34', lineHeight: 1.9 }}>吗？在哪一个字上拐的弯？</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center' }}>
      <Box style={{ flexDirection: 'row', gap: 10 }}>

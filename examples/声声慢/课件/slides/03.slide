  <Box style={{ height: 472, marginTop: 20, flexDirection: 'column' }}>
  <Box style={{ height: 472, justifyContent: 'center', flexDirection: 'column' }}>
    <Box style={{ padding: '32px 40px', background: 'rgba(31,58,52,0.05)' }}>
      <Text style={{ fontSize: 34, color: '#1F3A34', lineHeight: 1.9, letterSpacing: 2 }}>寻寻觅觅，冷冷清清，凄凄惨惨戚戚。</Text>

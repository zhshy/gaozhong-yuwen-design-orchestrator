<Slide style={{ background: '#F5F1E6', padding: '40px 64px', fontFamily: '宋体' }}>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', height: 72, position: 'relative', zIndex: 5 }}>

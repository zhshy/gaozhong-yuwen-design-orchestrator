  <Box style={{ height: 472, marginTop: 20, flexDirection: 'column', position: 'relative', zIndex: 5 }}>
  <Box style={{ flexDirection: 'row', height: 472, alignItems: 'center' }}>
    <Box style={{ flex: 1, marginRight: 18, padding: 28, background: 'rgba(31,58,52,0.06)', height: 320, flexDirection: 'column' }}>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1F3A34' }}>“这里我不懂”</Text>
      <Text style={{ fontSize: 27, color: '#1F3A34', lineHeight: 2.0, marginTop: 16 }}>这是我的事。</Text>
      <Text style={{ fontSize: 27, color: '#1F3A34', lineHeight: 2.0, marginTop: 8 }}>再读一遍，或问同学。</Text>
    </Box>
    <Box style={{ flex: 1, padding: 28, background: 'rgba(180,85,45,0.08)', height: 320, flexDirection: 'column' }}>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#B4552D' }}>“这里他不对”</Text>
      <Text style={{ fontSize: 27, color: '#1F3A34', lineHeight: 2.0, marginTop: 16 }}>这是作者的事。</Text>
      <Text style={{ fontSize: 27, color: '#B4552D', lineHeight: 2.0, marginTop: 8 }}>引出原话，说清为什么不成立。</Text>
    </Box>
  </Box>

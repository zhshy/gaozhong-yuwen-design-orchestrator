  <Box style={{ height: 472, marginTop: 20, flexDirection: 'column', position: 'relative', zIndex: 5 }}>
  <Box style={{ height: 472, flexDirection: 'column', justifyContent: 'center' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F3A34' }}>关键一问</Text>
    <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#B4552D', lineHeight: 1.6, marginTop: 20 }}>礼治有没有规矩？</Text>
    <Box style={{ marginTop: 30, borderLeft: '4px solid #B4552D', paddingLeft: 24 }}>
      <Text style={{ fontSize: 28, color: '#1F3A34', lineHeight: 2.0 }}>礼就是一套规矩。那它和法差在哪一步——</Text>
      <Text style={{ fontSize: 28, color: '#1F3A34', lineHeight: 2.0 }}>是有没有规矩，还是谁执行、靠什么执行？</Text>
    </Box>

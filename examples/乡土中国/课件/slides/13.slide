<Slide style={{ background: '#F5F1E6', padding: '40px 64px', fontFamily: '宋体' }}>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', height: 72, position: 'relative', zIndex: 5 }}>
    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F3A34', lineHeight: 1.15 }}>任务二：给十四篇配读法</Text>
    <Text style={{ fontSize: 24, color: '#6B6B6B' }}>小组 4 分钟</Text>
  </Box>
  <Box style={{ height: 472, marginTop: 20, flexDirection: 'column', position: 'relative', zIndex: 5 }}>
    <Box style={{ height: 472, flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 30, color: '#1F3A34', lineHeight: 2 }}>一、每组认领一个板块</Text>
      <Text style={{ fontSize: 30, color: '#1F3A34', lineHeight: 2 }}>二、判断本板块每一篇配哪种读法</Text>
      <Text style={{ fontSize: 30, color: '#1F3A34', lineHeight: 2 }}>三、理由要指出这篇的论证长什么样</Text>

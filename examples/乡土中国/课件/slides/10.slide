    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F3A34', lineHeight: 1.15 }}>读法四：找例</Text>
    <Text style={{ fontSize: 24, color: '#6B6B6B' }}>管迁移</Text>
  </Box>
  <Box style={{ height: 472, marginTop: 20, flexDirection: 'column', position: 'relative', zIndex: 5 }}>
    <Box style={{ height: 472, flexDirection: 'column', justifyContent: 'center' }}>
      <Box style={{ flexDirection: 'row', height: 120 }}>

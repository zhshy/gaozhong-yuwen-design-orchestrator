          <Text style={{ fontSize: 24, color: '#6B6B6B', marginTop: 8 }}>不打官司的完整样本</Text>
        </Box>
        <Box style={{ flex: 1, padding: 20, background: 'rgba(31,58,52,0.06)' }}>
          <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1F3A34' }}>贾母择钗</Text>
          <Text style={{ fontSize: 24, color: '#6B6B6B', marginTop: 8 }}>为什么选宝钗不选黛玉</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', height: 120, marginTop: 16 }}>
        <Box style={{ flex: 1, marginRight: 16, padding: 20, background: 'rgba(31,58,52,0.06)' }}>
          <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1F3A34' }}>刘十九</Text>
          <Text style={{ fontSize: 24, color: '#6B6B6B', marginTop: 8 }}>称谓里的血缘排行</Text>
        </Box>
        <Box style={{ flex: 1, padding: 20, background: 'rgba(31,58,52,0.06)' }}>
          <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1F3A34' }}>啥是佩奇</Text>

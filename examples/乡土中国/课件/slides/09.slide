<Slide style={{ background: '#F5F1E6', padding: '40px 64px', fontFamily: '宋体' }}>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', height: 72, position: 'relative', zIndex: 5 }}>
    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F3A34', lineHeight: 1.15 }}>读法三：画圈</Text>
    <Text style={{ fontSize: 24, color: '#6B6B6B' }}>管结构</Text>
  </Box>
  <Box style={{ height: 472, marginTop: 20, flexDirection: 'column', position: 'relative', zIndex: 5 }}>
    <Box style={{ flexDirection: 'row', height: 472, alignItems: 'center' }}>
      <Box style={{ width: 440, marginRight: 32, flexDirection: 'column' }}>
        <Image src="assets/img_waves.jpg" style={{ width: 440, height: 300, objectFit: 'cover' }} />
        <Text style={{ fontSize: 24, color: '#6B6B6B', marginTop: 10 }}>水波纹 · 水墨示意</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column' }}>
        <Text style={{ fontSize: 26, color: '#1F3A34', lineHeight: 1.8 }}>「好像把一块石头丢在水面上</Text>
        <Text style={{ fontSize: 26, color: '#1F3A34', lineHeight: 1.8 }}>所发生的一圈圈推出去的波纹。」</Text>
        <Text style={{ fontSize: 28, color: '#B4552D', marginTop: 20 }}>己 → 家 → 族 → 乡 → 天下</Text>
        <Text style={{ fontSize: 26, color: '#1F3A34', lineHeight: 1.9, marginTop: 20 }}>判据：箭头必须有字</Text>
        <Text style={{ fontSize: 26, color: '#1F3A34', lineHeight: 1.9 }}>没字的箭头等于没画</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 40, marginTop: 12, borderTop: '1px solid rgba(31,58,52,0.2)', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', paddingTop: 8, position: 'relative', zIndex: 5 }}>
    <Text style={{ fontSize: 24, color: '#6B6B6B' }}>《乡土中国》· 费孝通</Text>
    <Text style={{ fontSize: 24, color: '#B4552D' }}>09/19</Text>
  </Box>
</Slide>
<Slide style={{ background: '#F5F1E6', padding: '40px 64px', fontFamily: '宋体' }}>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', height: 72, position: 'relative', zIndex: 5 }}>
    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F3A34', lineHeight: 1.15 }}>四种读法，各问什么</Text>
    <Text style={{ fontSize: 24, color: '#6B6B6B' }}>小结对照</Text>
  </Box>
  <Box style={{ height: 472, marginTop: 20, flexDirection: 'column', position: 'relative', zIndex: 5 }}>
    <Box style={{ height: 472, flexDirection: 'column', justifyContent: 'center' }}>
      <Box style={{ flexDirection: 'row', height: 72, alignItems: 'center', borderBottom: '2px solid #B4552D' }}>
        <Text style={{ width: 180, fontSize: 26, fontWeight: 'bold', color: '#1F3A34' }}>读法</Text>
        <Text style={{ width: 180, fontSize: 26, fontWeight: 'bold', color: '#1F3A34' }}>管什么</Text>
        <Text style={{ flex: 1, fontSize: 26, fontWeight: 'bold', color: '#1F3A34' }}>它在问</Text>
      </Box>
      <Box style={{ flexDirection: 'row', height: 88, alignItems: 'center', borderBottom: '1px solid rgba(31,58,52,0.15)' }}>
        <Text style={{ width: 180, fontSize: 28, color: '#1F3A34' }}>接龙</Text>
        <Text style={{ width: 180, fontSize: 28, color: '#6B6B6B' }}>论证</Text>
        <Text style={{ flex: 1, fontSize: 28, color: '#1F3A34' }}>他怎么推的</Text>
      </Box>
      <Box style={{ flexDirection: 'row', height: 88, alignItems: 'center', borderBottom: '1px solid rgba(31,58,52,0.15)' }}>
        <Text style={{ width: 180, fontSize: 28, color: '#1F3A34' }}>分维</Text>
        <Text style={{ width: 180, fontSize: 28, color: '#6B6B6B' }}>辨析</Text>
        <Text style={{ flex: 1, fontSize: 28, color: '#1F3A34' }}>差在哪</Text>
      </Box>
      <Box style={{ flexDirection: 'row', height: 88, alignItems: 'center', borderBottom: '1px solid rgba(31,58,52,0.15)' }}>
        <Text style={{ width: 180, fontSize: 28, color: '#1F3A34' }}>画圈</Text>
        <Text style={{ width: 180, fontSize: 28, color: '#6B6B6B' }}>结构</Text>
        <Text style={{ flex: 1, fontSize: 28, color: '#1F3A34' }}>在哪一格</Text>
      </Box>
      <Box style={{ flexDirection: 'row', height: 88, alignItems: 'center' }}>
        <Text style={{ width: 180, fontSize: 28, color: '#1F3A34' }}>找例</Text>
        <Text style={{ width: 180, fontSize: 28, color: '#6B6B6B' }}>迁移</Text>
        <Text style={{ flex: 1, fontSize: 28, color: '#1F3A34' }}>今天还成不成立</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 40, marginTop: 12, borderTop: '1px solid rgba(31,58,52,0.2)', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', paddingTop: 8, position: 'relative', zIndex: 5 }}>
    <Text style={{ fontSize: 24, color: '#6B6B6B' }}>《乡土中国》· 费孝通</Text>
    <Text style={{ fontSize: 24, color: '#B4552D' }}>11/19</Text>
  </Box>
</Slide>
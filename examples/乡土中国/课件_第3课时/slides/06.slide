    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F3A34', lineHeight: 1.15 }}>原文：一块石头丢在水面上</Text>
    <Text style={{ fontSize: 24, color: '#6B6B6B' }}>第 4 篇</Text>

<Slide style={{ width: 1280, height: 720, padding: '20px 64px', background: '#F7F4EC', flexDirection: 'column' }}>
  <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 6, height: 34, background: '#A8351A' }} />
      <Text style={{ fontFamily: 'KaiTi', fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>任务二 · 减法之「声」与「味」</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 18, color: '#3F4A55', letterSpacing: 1 }}>02</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'row', gap: 32 }}>
    <Box style={{
      width: 360, height: 540, background: 'rgba(63,74,85,0.06)', borderLeft: '4px solid #A8351A',
      padding: '48px 36px', flexDirection: 'column', justifyContent: 'space-between',
    }}>
      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 20, color: '#3F4A55', letterSpacing: 2 }}>他删掉了</Text>

      <Text style={{ fontFamily: 'KaiTi', fontSize: 76, fontWeight: 'bold', color: '#1A1A1A', lineHeight: 1.25, textDecoration: 'line-through' }}>声</Text>
      <Text style={{ fontFamily: 'KaiTi', fontSize: 76, fontWeight: 'bold', color: '#1A1A1A', lineHeight: 1.25, textDecoration: 'line-through' }}>味</Text>

      <Box style={{ width: 48, height: 3, background: '#A8351A' }} />
    </Box>

    <Box style={{ width: 760, height: 540, flexDirection: 'column', justifyContent: 'space-between' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 26, height: 3, background: '#A8351A' }} />
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 20, color: '#3F4A55', letterSpacing: 2 }}>原文</Text>
      </Box>

      <Box>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 24, color: '#3F4A55', lineHeight: 1.7 }}>像花而又不是花的那一种落蕊，早晨起来，会铺得满地。</Text>

        <Box style={{ width: '100%', height: 2, background: 'rgba(26,26,26,0.12)', marginTop: 22, marginBottom: 26 }} />

        <Text style={{ fontFamily: 'KaiTi', fontSize: 34, color: '#1A1A1A', lineHeight: 1.7 }}>
          脚踏上去，<span style={{ color: '#A8351A', fontWeight: 'bold' }}>声音也没有</span>，<span style={{ color: '#A8351A', fontWeight: 'bold' }}>气味也没有</span>，<br />
          只能感出<span style={{ fontWeight: 'bold' }}>一点点极微细极柔软的触觉</span>。
        </Text>
      </Box>

      <Box style={{ background: 'rgba(168,53,26,0.07)', padding: '22px 28px' }}>
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 36, fontWeight: 'bold', color: '#1A1A1A', lineHeight: 1.5 }}>
          这两个「没有」，删掉了什么？
        </Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
      <Box style={{ width: 22, height: 22, background: '#A8351A', alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 13, fontWeight: 'bold', color: '#F7F4EC' }}>秋</Text>
      </Box>
      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>故都的秋 · 郁达夫</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>08 / 15</Text>
  </Box>
</Slide>

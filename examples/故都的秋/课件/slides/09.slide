<Slide style={{ width: 1280, height: 720, padding: '20px 64px', background: '#F7F4EC', flexDirection: 'column' }}>
  <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 6, height: 34, background: '#A8351A' }} />
      <Text style={{ fontFamily: 'KaiTi', fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>任务二 · 减法之「繁华」</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 18, color: '#3F4A55', letterSpacing: 1 }}>02</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'row', gap: 32 }}>
    <Box style={{ width: 672, height: 540, flexDirection: 'column', justifyContent: 'space-between' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 26, height: 3, background: '#A8351A' }} />
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 20, color: '#3F4A55', letterSpacing: 2 }}>原文 · 南国之秋「正像是」</Text>
      </Box>

      <Box style={{ flexDirection: 'column', gap: 14 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 28, color: '#3F4A55', width: 110 }}>黄酒</Text>
          <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 22, color: 'rgba(26,26,26,0.35)' }}>之与</Text>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>白干</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 28, color: '#3F4A55', width: 110 }}>稀饭</Text>
          <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 22, color: 'rgba(26,26,26,0.35)' }}>之与</Text>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>馍馍</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 28, color: '#3F4A55', width: 110 }}>鲈鱼</Text>
          <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 22, color: 'rgba(26,26,26,0.35)' }}>之与</Text>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>大蟹</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 28, color: '#3F4A55', width: 110 }}>黄犬</Text>
          <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 22, color: 'rgba(26,26,26,0.35)' }}>之与</Text>
          <Text style={{ fontFamily: 'KaiTi', fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>骆驼</Text>
        </Box>
      </Box>

      <Text style={{ fontFamily: 'KaiTi', fontSize: 30, color: '#1A1A1A', lineHeight: 1.6 }}>
        色彩不浓，回味不永。
      </Text>
    </Box>

    <Box style={{
      width: 448, height: 540, background: 'rgba(63,74,85,0.06)',
      padding: '48px 36px', flexDirection: 'column', justifyContent: 'space-between',
    }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 26, height: 3, background: '#A8351A' }} />
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 20, color: '#3F4A55', letterSpacing: 2 }}>追问</Text>
      </Box>

      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 40, fontWeight: 'bold', color: '#1A1A1A', lineHeight: 1.55 }}>
        他嫌南国的秋<br /><span style={{ color: '#3F4A55' }}>「不好」</span>，<br />还是<span style={{ color: '#A8351A', fontSize: 48 }}>「不够」</span>？
      </Text>

      <Box style={{ width: 48, height: 3, background: 'rgba(26,26,26,0.18)' }} />
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
      <Box style={{ width: 22, height: 22, background: '#A8351A', alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 13, fontWeight: 'bold', color: '#F7F4EC' }}>秋</Text>
      </Box>
      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>故都的秋 · 郁达夫</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>09 / 15</Text>
  </Box>
</Slide>

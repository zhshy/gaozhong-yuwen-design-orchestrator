<Slide style={{ width: 1280, height: 720, padding: '20px 64px', background: '#F7F4EC', flexDirection: 'column' }}>
  <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 6, height: 34, background: '#A8351A' }} />
      <Text style={{ fontFamily: 'KaiTi', fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>任务三 · 「故都」与「秋」</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 18, color: '#3F4A55', letterSpacing: 1 }}>03</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'row', gap: 32 }}>
    <Box style={{
      width: 360, height: 540, background: 'rgba(63,74,85,0.06)', borderLeft: '4px solid #A8351A',
      padding: '48px 36px', flexDirection: 'column', justifyContent: 'space-between',
    }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 26, height: 3, background: '#A8351A' }} />
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 20, color: '#3F4A55', letterSpacing: 2 }}>任务三</Text>
      </Box>

      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 36, fontWeight: 'bold', color: '#1A1A1A', lineHeight: 1.55 }}>
        两个词，<br />各指什么？
      </Text>

      <Box style={{ width: 48, height: 3, background: 'rgba(26,26,26,0.18)' }} />
    </Box>

    <Box style={{ width: 760, height: 540, flexDirection: 'column', justifyContent: 'space-between' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 52, fontWeight: 'bold', color: '#1A1A1A', width: 160 }}>故都</Text>
        <Box style={{ width: 3, height: 72, background: '#A8351A', marginRight: 26 }} />
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 28, color: '#3F4A55', lineHeight: 1.6 }}>
          曾是都城，<span style={{ color: '#1A1A1A', fontWeight: 'bold' }}>今已不是</span>
        </Text>
      </Box>

      <Box style={{ height: 2, background: 'rgba(26,26,26,0.12)', width: '100%' }} />

      <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 52, fontWeight: 'bold', color: '#1A1A1A', width: 160 }}>秋</Text>
        <Box style={{ width: 3, height: 72, background: '#A8351A', marginRight: 26 }} />
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 28, color: '#3F4A55', lineHeight: 1.6 }}>
          一年盛时，<span style={{ color: '#1A1A1A', fontWeight: 'bold' }}>行将结束</span>
        </Text>
      </Box>

      <Box style={{ background: 'rgba(168,53,26,0.07)', padding: '24px 28px' }}>
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 36, fontWeight: 'bold', color: '#1A1A1A' }}>
          这两处，像在哪一点上？
        </Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
      <Box style={{ width: 22, height: 22, background: '#A8351A', alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 13, fontWeight: 'bold', color: '#F7F4EC' }}>秋</Text>
      </Box>
      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>故都的秋 · 郁达夫</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>11 / 15</Text>
  </Box>
</Slide>

<Slide style={{ width: 1280, height: 720, padding: '20px 64px', background: '#F7F4EC', flexDirection: 'column' }}>
  <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 6, height: 34, background: '#A8351A' }} />
      <Text style={{ fontFamily: 'KaiTi', fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>任务二 · 减法之「色」</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 18, color: '#3F4A55', letterSpacing: 1 }}>02</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'row', gap: 32, alignItems: 'center' }}>
    <Image src="assets/morning_glory.png" style={{ width: 680, height: 500, objectFit: 'cover' }} />

    <Box style={{ width: 440, height: 500, flexDirection: 'column', justifyContent: 'space-between' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 26, height: 3, background: '#A8351A' }} />
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 20, color: '#3F4A55', letterSpacing: 2 }}>原文</Text>
      </Box>

      <Text style={{ fontFamily: 'KaiTi', fontSize: 30, color: '#1A1A1A', lineHeight: 1.7 }}>
        牵牛花以<span style={{ color: '#A8351A', fontWeight: 'bold' }}>蓝色或白色</span>者为佳，<br />
        紫黑色次之，<br />
        <span style={{ color: '#A8351A', fontWeight: 'bold' }}>淡红者最下</span>。
      </Text>

      <Box style={{ borderTop: '2px solid rgba(26,26,26,0.14)', paddingTop: 26 }}>
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 36, fontWeight: 'bold', color: '#1A1A1A', lineHeight: 1.5 }}>
          他凭什么，<br />给颜色排序？
        </Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
      <Box style={{ width: 22, height: 22, background: '#A8351A', alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 13, fontWeight: 'bold', color: '#F7F4EC' }}>秋</Text>
      </Box>
      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>故都的秋 · 郁达夫</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>07 / 15</Text>
  </Box>
</Slide>

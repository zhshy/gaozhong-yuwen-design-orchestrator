<Slide style={{ width: 1280, height: 720, padding: '20px 64px', background: '#F7F4EC', flexDirection: 'column' }}>
  <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 6, height: 34, background: '#A8351A' }} />
      <Text style={{ fontFamily: 'KaiTi', fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>任务一 · 追问</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 18, color: '#3F4A55', letterSpacing: 1 }}>01</Text>
  </Box>

  <Box style={{ height: 540, flexDirection: 'row', gap: 32 }}>
    <Box style={{ width: 728, height: 540, position: 'relative', justifyContent: 'center', paddingLeft: 8 }}>
      <Text style={{
        position: 'absolute', right: 0, bottom: 0,
        fontFamily: 'KaiTi', fontSize: 300, fontWeight: 'bold',
        color: 'rgba(63,74,85,0.07)', lineHeight: 1.0,
      }}>味</Text>

      <Box style={{ position: 'relative', zIndex: 1 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 26 }}>
          <Box style={{ width: 26, height: 3, background: '#A8351A' }} />
          <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 20, color: '#3F4A55', letterSpacing: 2 }}>原文</Text>
        </Box>

        <Text style={{ fontFamily: 'KaiTi', fontSize: 40, color: '#1A1A1A', lineHeight: 1.6 }}>
          秋的味，秋的色，秋的意境与姿态，<br />
          总<span style={{ color: '#A8351A', fontWeight: 'bold' }}>看不饱</span>，<span style={{ color: '#A8351A', fontWeight: 'bold' }}>尝不透</span>，<br />
          赏玩不到十足。
        </Text>
      </Box>
    </Box>

    <Box style={{
      width: 392, height: 540, background: 'rgba(63,74,85,0.06)',
      padding: '44px 36px', flexDirection: 'column', justifyContent: 'space-between',
    }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 26, height: 3, background: '#A8351A' }} />
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 20, color: '#3F4A55', letterSpacing: 2 }}>追问</Text>
      </Box>

      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 36, fontWeight: 'bold', color: '#1A1A1A', lineHeight: 1.6 }}>
        味是<span style={{ color: '#A8351A' }}>尝</span>出来的——<br />秋天，怎么「尝」？
      </Text>

      <Box style={{ width: 48, height: 3, background: 'rgba(26,26,26,0.18)' }} />
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
      <Box style={{ width: 22, height: 22, background: '#A8351A', alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontFamily: 'KaiTi', fontSize: 13, fontWeight: 'bold', color: '#F7F4EC' }}>秋</Text>
      </Box>
      <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>故都的秋 · 郁达夫</Text>
    </Box>
    <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 14, color: '#3F4A55' }}>06 / 15</Text>
  </Box>
</Slide>
